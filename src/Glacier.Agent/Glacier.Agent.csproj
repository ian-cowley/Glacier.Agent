<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Glacier.Agent</PackageId>
    <Version>1.5.3</Version>
    <PackageReleaseNotes>v1.5.3: Fail-closed Linux namespace isolation policy and aligned Clavier 1.2.1 / MemEx 1.2.3 dependencies.</PackageReleaseNotes>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Pure C# .NET 10 Autonomous Agent Runtime, compressed SIMD Radix Trie Tokenizer, Native AOT Branchless CLI, trained IVF-PQ / thread-safe HNSW Vector Index, and source-generated MCP Event Bus.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Agent</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Agent.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>agent;tokenizer;bpe;simd;aot;cli;hnsw;ivf-pq;vector-search;mcp;actor;net10;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <Content Include="runtimes\**\*" Pack="true" PackagePath="runtimes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="OpenTelemetry" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../Glacier.Clavier/src/Glacier.Clavier/Glacier.Clavier.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="../../../Glacier.Clavier/src/Glacier.Clavier/Glacier.Clavier.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../Glacier.Clavier/src/Glacier.Clavier/Glacier.Clavier.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.Clavier" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../Glacier.MemEx/src/Glacier.MemEx/Glacier.MemEx.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="../../../Glacier.MemEx/src/Glacier.MemEx/Glacier.MemEx.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../Glacier.MemEx/src/Glacier.MemEx/Glacier.MemEx.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.MemEx" />
  </ItemGroup>
</Project>
